    "purchase.list": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Descending and harmonic intervals, custom ranges and sets, scheduled reviews and weekly trends."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下行与和声音程、自选音域与题包、到期复练和每周趋势。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下行與和聲音程、自選音域與題包、到期復練和每週趨勢。"}}}},
    "purchase.trialTerms": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Pro is included for 30 days from first opening the paid edition. The optional free receipt helps restore the trial; claiming it does not restart the clock. No automatic charge."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从首次打开收费版起，免费使用高级功能 30 天。可选领 0 元凭证用于恢复试用，领取不会重新计时，也不会自动扣款。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"從首次開啟收費版起，免費使用進階功能 30 天。可選領 0 元憑證以回復試用，領取不會重新計時，也不會自動扣款。"}}}},
