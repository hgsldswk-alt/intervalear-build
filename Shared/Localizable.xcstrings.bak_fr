    "purchase.list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descending and harmonic intervals, custom ranges and sets, scheduled reviews and weekly trends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下行与和声音程、自选音域与题包、到期复练和每周趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下行與和聲音程、自選音域與題包、到期復練和每週趨勢。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下行・和声音程、カスタム音域とセット、復習スケジュール、週ごとの傾向。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하행·화성 음정, 사용자 음역과 세트, 예약 복습, 주간 추이."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absteigende und harmonische Intervalle, eigene Tonumfänge und Sets, geplante Wiederholungen und Wochentrends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos descendentes y armónicos, rangos y sets personalizados, repasos programados y tendencias semanales."
          }
        }
      }
    },
    "purchase.trialTerms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is included for 30 days from first opening the paid edition. The optional free receipt helps restore the trial; claiming it does not restart the clock. No automatic charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从首次打开收费版起，免费使用高级功能 30 天。可选领 0 元凭证用于恢复试用，领取不会重新计时，也不会自动扣款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從首次開啟收費版起，免費使用進階功能 30 天。可選領 0 元憑證以回復試用，領取不會重新計時，也不會自動扣款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有料版を初めて開いた日から30日間Proが使えます。任意の無料レシートはお試しの復元に役立ちますが、受け取っても期間はやり直しになりません。自動課金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유료 버전을 처음 연 날부터 30일 동안 Pro가 포함됩니다. 선택 사항인 무료 영수증은 체험 복원에 도움이 되며, 받아도 기간이 다시 시작되지 않습니다. 자동 결제는 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ist 30 Tage ab dem ersten Öffnen der Kaufversion enthalten. Der optionale Gratisbeleg hilft, den Test wiederherzustellen; die Frist beginnt dadurch nicht neu. Keine automatische Abbuchung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro está incluido 30 días desde que abres por primera vez la edición de pago. El recibo gratis opcional ayuda a restaurar la prueba; obtenerlo no reinicia el plazo. Sin cobro automático."
          }
        }
      }
    },
    "purchase.after": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the trial, basic practice and your existing progress, misses and saved sets remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用到期后，仍可做基础练习，并保留已有进度、错题和题包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用到期後，仍可做基礎練習，並保留既有進度、錯題及題包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し終了後も、基本の練習と今までの進み具合、間違い、保存したセットは使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나도 기본 연습과 기존 진행, 틀린 문제, 저장한 세트는 계속 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Testphase bleiben die einfache Übung sowie dein Fortschritt, deine Fehler und gesicherte Sets verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la prueba siguen disponibles la práctica básica, tu progreso, tus fallos y los sets guardados."
          }
        }
      }
    },
