    "sets.invalidPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the direction and choose four distinct intervals including the correct answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查方向，并选择四种不同的音程，其中必须包含正确答案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
