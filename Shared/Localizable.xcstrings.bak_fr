          "stringUnit": {
            "state": "translated",
            "value": "至少选四种音程；音域要宽于最大音程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少選四種音程；音域須寬於最大音程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音程を4つ以上選び、最大の音程より広い音域にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음정을 네 개 이상 고르고, 가장 큰 음정보다 넓은 음역을 정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens vier Intervalle und einen Tonumfang größer als das größte Intervall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos cuatro intervalos y un rango mayor que el intervalo más grande."
          }
        }
      }
    },
