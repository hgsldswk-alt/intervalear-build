          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少选四种音程；音域要宽于最大音程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少選四種音程；音域須寬於最大音程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音程を4つ以上選び、最大の音程より広い音域にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음정을 네 개 이상 고르고, 가장 큰 음정보다 넓은 음역을 정하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mindestens vier Intervalle und einen Tonumfang größer als das größte Intervall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige al menos cuatro intervalos y un rango mayor que el intervalo más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis au moins quatre intervalles et une tessiture plus large que le plus grand intervalle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pelo menos quatro intervalos e uma extensão maior que o maior intervalo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli almeno quattro intervalli e un’estensione più ampia dell’intervallo maggiore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies minstens vier intervallen en een bereik dat groter is dan het grootste interval."
          }
        }
      }
    },
