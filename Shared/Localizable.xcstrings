    "error.audio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback stopped or no audible output is available. Check your volume or audio device, then replay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已中断或没有可用的声音输出。请检查音量或音频设备后重播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放已中斷或沒有可用的聲音輸出。請檢查音量或音訊裝置後重播。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が止まったか、音が出せる出力先がありません。音量やオーディオ機器を確認して、もう一度再生してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 멈췄거나 들리는 출력이 없습니다. 볼륨이나 오디오 기기를 확인하고 다시 재생하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe gestoppt oder keine hörbare Ausgabe. Prüfe Lautstärke oder Audiogerät und spiel erneut ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción se detuvo o no hay salida audible. Revisa el volumen o el dispositivo de audio y vuelve a tocar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture arrêtée ou aucune sortie audible. Vérifie le volume ou l’appareil audio, puis rejoue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução parou ou não há saída audível. Verifique o volume ou o dispositivo de áudio e toque de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione si è fermata o non c’è un’uscita udibile. Controlla il volume o il dispositivo audio, poi risuona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen gestopt of er is geen hoorbare uitvoer. Controleer je volume of audioapparaat en speel opnieuw af."
          }
        }
      }
    },
    "error.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save or load practice. Your last saved progress is unchanged. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法保存或读取练习。上次保存的进度没有改变，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法儲存或讀取練習。上次儲存的進度沒有改變，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習を保存または読み込みできませんでした。最後に保存した進み具合はそのままです。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습을 저장하거나 불러오지 못했습니다. 마지막으로 저장한 진행은 그대로입니다. 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übung konnte nicht gesichert oder geladen werden. Dein zuletzt gesicherter Fortschritt ist unverändert. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar ni cargar la práctica. Tu último progreso guardado no cambió. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer ou de charger l’exercice. Ta dernière progression enregistrée est inchangée. Réessaie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar ou carregar o exercício. Seu último progresso salvo não mudou. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare o caricare l’esercizio. L’ultimo progresso salvato non è cambiato. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de oefening niet bewaren of laden. Je laatst bewaarde voortgang is ongewijzigd. Probeer opnieuw."
          }
        }
      }
    },
